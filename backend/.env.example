# Copy this file to .env and fill in real values. Never commit the real .env.

# Turn OFF in production. Only "true" on your own machine while developing.
FLASK_DEBUG=false

# Comma-separated list of the exact frontend origin(s) allowed to call this
# API. No trailing slash. Example for a real deployment:
# ALLOWED_ORIGINS=https://shelbysarteves.com,https://www.shelbysarteves.com
ALLOWED_ORIGINS=http://localhost:5173

# Long random secret used to view /api/leads and /api/analytics/summary.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave unset to keep those endpoints disabled entirely.
ADMIN_TOKEN=

# Optional: point rate limiting at Redis for multi-instance deployments.
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379

# Port Gunicorn binds to (most hosts set this automatically).
PORT=8000
